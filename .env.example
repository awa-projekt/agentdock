# Model provider keys. The seeded agents use OpenAI; set the others only if you
# use their models. Keys can also be stored in the web UI instead.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# Required: signs login sessions. The API does not start without it, even with
# auth disabled. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Ports are derived from the checkout: the main checkout uses 38123/38124, every
# linked worktree hashes its own path into a stable pair of its own. Run
# `bun run urls` to see them. Set AGENTDOCK_PORT_BASE to pin the api port (web
# takes the next one); AGENTDOCK_API_URL / AGENTDOCK_PUBLIC_API_URL /
# AGENTDOCK_WEB_ORIGIN only need setting when the app is not reached over
# 127.0.0.1, e.g. a deployed environment.
#
# The API and web server listen on 127.0.0.1. Set AGENTDOCK_SERVER_HOST=0.0.0.0
# to reach them from other machines (AGENTDOCK_WEB_HOST overrides it for the web
# server only).
# AGENTDOCK_SERVER_HOST=127.0.0.1

# Master key for encrypting stored provider keys and integration credentials.
# Use at least 32 random bytes and keep the value stable. When unset in
# development a built-in, publicly known key is used (the API logs a warning);
# outside development (NODE_ENV other than `development`) it must be set.
AGENTDOCK_SECRET_KEY=

# OTLP export to the collector from docker/compose.yaml. Without that stack
# running the API logs a warning and carries on; comment the endpoint out to
# turn export off. TEMPO_URL is what the in-app Traces view reads from.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=agentdock-api
# AGENTDOCK_LOG_LEVEL=Info

TEMPO_URL=http://127.0.0.1:3200

# Triggers: how often the scheduler wakes to fire due schedule triggers and poll
# mail (seconds; default 30).
TRIGGER_SCHEDULER_INTERVAL_SECONDS=30

# Email triggers via Microsoft 365 / Outlook (app-only Graph access). Leave blank
# to disable email triggers. The app needs the Mail.Read application permission,
# scoped to the monitored (typically shared) mailboxes via an Application Access
# Policy.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Langfuse project API keys, consumed by the otel-collector (docker/compose.yaml)
# to forward LLM spans. Defaults match the auto-provisioned dev project
# (login: dev@agentdock.local / agentdock-dev at http://localhost:3000).
LANGFUSE_PUBLIC_KEY=pk-lf-agentdock-dev
LANGFUSE_SECRET_KEY=sk-lf-agentdock-dev
