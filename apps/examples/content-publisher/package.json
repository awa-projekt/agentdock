{
  "name": "agentdock-example-content-publisher",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Self-contained example client for AgentDock: human-in-the-loop content publishing.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "mcp": "node --env-file-if-exists=.env --watch --import tsx mcp/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@hono/node-server": "^2.0.6",
    "@tanstack/react-query": "^5.100.11",
    "fastmcp": "^4.3.1",
    "hono": "^4.12.26",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
