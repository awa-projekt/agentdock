# Port the example's Hono backend listens on.
PORT=8787

# Base URL of a running AgentDock server (its API / A2A host). Defaults to the
# API of the checkout this example sits in (`bun run urls` at the repo root).
# AGENTDOCK_URL=http://127.0.0.1:38123

# Id of the "content publisher" workflow you built in AgentDock.
# Find it in the AgentDock dashboard URL or via `GET /workflows`.
WORKFLOW_ID=

# Secret used to sign the session cookie. Use any random string.
SESSION_SECRET=dev-secret-change-me

# Port the mock "publishing platform" MCP server listens on.
# Wire it into AgentDock as an MCP source at http://localhost:8910/mcp
MCP_PORT=8910
