    "knip": "^6.35.1",
    "langchain": "^1.5.2",
    "lefthook": "^2.1.14",
    "lucide-react": "^0.545.0",
    "oxlint": "^1.78.0",
    "react": "^19",
    "react-dom": "^19",
    "semver": "^7.7.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "tiktoken": "^1.0.22",
    "use-stick-to-bottom": "^1.1.4",
    "wouter": "^3.10.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "^0.87.2",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "4.0.0",
    "@langchain/core": "catalog:",
    "@langchain/langgraph": "^1.4.5",
    "@libsql/client": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "agentdock-patterns": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "lefthook": "catalog:",
    "knip": "catalog:",
    "langchain": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
