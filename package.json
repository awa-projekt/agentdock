{
  "name": "agentdock",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "awa-projekt <info@ancud.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awa-projekt/agentdock.git"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:no-auth": "AGENTDOCK_DISABLE_AUTH=1 node --import tsx scripts/dev.ts",
    "urls": "node --import tsx scripts/urls.ts",
    "kill": "lsof -ti tcp:$(node --import tsx scripts/urls.ts --ports) | xargs -r kill",
    "api": "node --watch --no-warnings=ExperimentalWarning --import tsx apps/server/src/index.ts",
    "api:no-auth": "AGENTDOCK_DISABLE_AUTH=1 node --watch --no-warnings=ExperimentalWarning --import tsx apps/server/src/index.ts",
    "web": "NODE_ENV=production node --import tsx apps/web/src/index.ts",
    "web:dev": "NODE_ENV=development node --watch --import tsx apps/web/src/index.ts",
    "web:dev:no-auth": "AGENTDOCK_DISABLE_AUTH=1 NODE_ENV=development node --watch --import tsx apps/web/src/index.ts",
    "cli": "node --import tsx apps/cli/src/index.ts",
    "db:seed": "node --import tsx scripts/seed-agents.ts",
    "db:generate": "bun --cwd packages/db drizzle-kit generate",
    "db:reset": "node --import tsx scripts/reset-db.ts",
    "db:encrypt-secrets": "node --import tsx scripts/encrypt-secrets-at-rest.ts",
    "prepare": "effect-language-service patch && lefthook install --force",
    "test": "vitest run",
    "lint": "biome lint . && oxlint",
    "lint:anti-slop": "oxlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip --preprocessor ./scripts/knip-schemas.ts",
    "knip:production": "knip --production --preprocessor ./scripts/knip-schemas.ts",
    "check": "biome check . && oxlint",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && bun run --filter agentdock-web typecheck",
    "cloc": "git ls-files | xargs cloc"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "effect": "4.0.0",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-libsql": "4.0.0"
  },
  "catalog": {
    "@a2a-js/sdk": "^0.3.13",
    "@base-ui/react": "^1.5.0",
    "@better-auth/drizzle-adapter": "^1.6.20",
    "@biomejs/biome": "^2.5.1",
    "@cfworker/json-schema": "^4.1.1",
    "@chat-adapter/discord": "^4.40.0",
    "@chat-adapter/teams": "^4.40.0",
    "@dagrejs/dagre": "^1.1.5",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-libsql": "4.0.0",
    "@executor-js/codemode-core": "1.5.17",
    "@executor-js/runtime-quickjs": "1.5.17",
    "@integragents/contracts": "0.3.2-nightly.20261002.21",
    "@integragents/gateway-core": "0.3.2-nightly.20261002.21",
    "@integragents/host": "0.3.2-nightly.20261002.21",
    "@integragents/observability": "0.3.2-nightly.20261002.21",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.12",
    "@langchain/deepseek": "^1.1.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/mistralai": "^1.2.0",
    "@langchain/openai": "^1.5.13",
    "@langchain/xai": "^1.4.3",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.204.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@oxlint/plugins": "^1.78.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.11",
    "@types/node": "^24.13.0",
    "@types/semver": "^7.7.0",
    "@xyflow/react": "^12.10.2",
    "better-auth": "^1.6.20",
    "chat": "^4.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
